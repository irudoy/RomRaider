<project name="romraider" default="help" basedir=".">

    <!-- get the environment -->
    <property environment="env" />

    <!-- =================================================================== -->
    <!-- Help                                                                -->
    <!--   All externally callable targets should be listed here, along      -->
    <!--   with common property overrides                                    -->
    <!-- =================================================================== -->
    <target name="help" depends="-init">
        <echo message="help        [Print this message                     ]" />
        <echo message="clean       [Clean generated files                  ]" />
        <echo message="prepare     [Create directories for output files    ]" />
        <echo message="            [  and generate the Version class       ]" />
        <echo message="build       [Compile the Java source files          ]" />
        <echo message="rebuild     [Call the clean and build targets       ]" />
        <echo message="javadoc     [Generate the API documentation of the  ]" />
        <echo message="            [  Java source code                     ]" />
        <echo message="standalone  [Create the ZIP packages                ]" />
        <echo message="all         [Complete rebuild and packaging         ]" />
        <echo message="unittest    [Run all unit tests                     ]" />
    </target>

    <!-- =================================================================== -->
    <!-- Initialization target - only callable internally                    -->
    <!-- =================================================================== -->
    <target name="-init" unless="initialized" description="Initialize the build environment">
        <property name="initialized" value="true" />
        <!-- set the various timestamp properties we may need -->
        <tstamp>
            <format property="time.rfc822" pattern="EEE, dd MMM yyyy HH:mm:ss Z" locale="en"/>
            <format property="time.year" pattern="yyyy" locale="en"/>
            <format property="build.month" pattern="MM" locale="en"/>
            <format property="build.day" pattern="dd" locale="en"/>
        </tstamp>

        <!-- Keep release identifiers stable without the removed Nashorn runtime. -->
        <condition property="mnth.day" value="JAN${build.day}">
            <equals arg1="${build.month}" arg2="01" />
        </condition>
        <condition property="mnth.day" value="FEB${build.day}">
            <equals arg1="${build.month}" arg2="02" />
        </condition>
        <condition property="mnth.day" value="MAR${build.day}">
            <equals arg1="${build.month}" arg2="03" />
        </condition>
        <condition property="mnth.day" value="APR${build.day}">
            <equals arg1="${build.month}" arg2="04" />
        </condition>
        <condition property="mnth.day" value="MAY${build.day}">
            <equals arg1="${build.month}" arg2="05" />
        </condition>
        <condition property="mnth.day" value="JUN${build.day}">
            <equals arg1="${build.month}" arg2="06" />
        </condition>
        <condition property="mnth.day" value="JUL${build.day}">
            <equals arg1="${build.month}" arg2="07" />
        </condition>
        <condition property="mnth.day" value="AUG${build.day}">
            <equals arg1="${build.month}" arg2="08" />
        </condition>
        <condition property="mnth.day" value="SEP${build.day}">
            <equals arg1="${build.month}" arg2="09" />
        </condition>
        <condition property="mnth.day" value="OCT${build.day}">
            <equals arg1="${build.month}" arg2="10" />
        </condition>
        <condition property="mnth.day" value="NOV${build.day}">
            <equals arg1="${build.month}" arg2="11" />
        </condition>
        <condition property="mnth.day" value="DEC${build.day}">
            <equals arg1="${build.month}" arg2="12" />
        </condition>

        <!-- set os specific properties -->
        <property name="os.windows" value="windows" />
        <property name="ext.windows" value="bat" />
        <property name="os.linux" value="linux" />
        <property name="ext.linux" value="sh" />

        <condition property="os" value="${os.windows}" else="${os.linux}">
            <os family="windows" />
        </condition>

        <!-- java compiler properties -->
        <property name="javac.release" value="17" />
        <property name="debug" value="off" />
        <property name="deprecation" value="on" />
        <property name="javac.verbose" value="off" />
        <property name="test.headless" value="true" />
        <property name="romraider.test.xdfDir" value="" />

        <!-- version properties are set in this file, both for the product itself and
                for some of the external dependencies (jar files and such) -->
        <property file="version.properties" />

        <!-- basic project properties -->
        <property name="src.dir" value="${basedir}/src" />
        <property name="src.java.dir" value="${src.dir}/main/java" />
        <property name="src.res.dir" value="${src.dir}/main/resources" />
        <property name="src.test.java.dir" value="${src.dir}/test/java" />
        <property name="graphics.dir" value="${src.res.dir}/graphics" />
        <property name="docs.dir" value="${basedir}/docs" />
        <property name="build.dir" value="${basedir}/build" />

        <!-- all generated files should go to somewhere in the build directory -->
        <property name="classes.dir" value="${build.dir}/classes" />
        <property name="javadoc.dir" value="${build.dir}/javadoc" />
        <property name="dist.dir" value="${build.dir}/dist" />
        <property name="testclasses.dir" value="${build.dir}/test" />
        <property name="test.home.dir" value="${build.dir}/test-home" />

        <!-- package naming properties -->
        <property name="jar.package" value="${name.package}.jar" />

        <!-- JogAmp Java3D, downloaded once into a cache outside the build tree -->
        <property name="maven.central" value="https://repo1.maven.org/maven2" />
        <property name="jogamp.dir" value="${basedir}/lib/jogamp" />
        <property name="java3d.version" value="1.7.2" />
        <property name="jogamp.version" value="2.6.0" />
        <property name="jogamp.natives.windows" value="windows-amd64" />
        <property name="jogamp.natives.linux" value="linux-amd64" />
        <property name="java3d.dir" value="${build.dir}/java3d" />
        <property name="graph3d.adapted" value="${java3d.dir}/Graph3d.jar" />

        <path id="windows.classpath">
            <fileset dir="lib/common" includes="*.jar" />
            <fileset dir="lib/windows" includes="*.jar" />
        </path>

        <path id="linux.classpath">
            <fileset dir="lib/common" includes="*.jar" />
            <fileset dir="lib/linux" includes="*.jar" />
        </path>

        <path id="junit_compile.classpath">
            <path refid="linux.classpath" />
            <pathelement location="${build.dir}/linux/package/${jar.package}" />
            <pathelement location="lib/testing/junit.jar" />
            <pathelement location="lib/testing/hamcrest.jar" />
        </path>

        <path id="junit_runtime.classpath">
            <path refid="junit_compile.classpath" />
            <pathelement location="${testclasses.dir}" />
        </path>

        <!-- this set of filters should contain all the substitutions needed -->
        <filterset id="version.filterset">
            <filter token="time.year" value="${time.year}" />
            <filter token="warning.generated-file" value="${warning.generated-file}" />
            <filter token="name.package" value="${name.package}" />
            <filter token="supporturl" value="${supporturl}" />
            <filter token="romrevisionurl" value="${romrevisionurl}" />
            <filter token="ecudefsurl" value="${ecudefsurl}" />
            <filter token="loggerdefsurl" value="${loggerdefsurl}" />
            <filter token="carsdefsurl" value="${carsdefsurl}" />
            <filter token="release_notes" value="${release_notes}" />
            <filter token="version.major" value="${version.major}" />
            <filter token="version.minor" value="${version.minor}" />
            <filter token="version.patch" value="${version.patch}" />
            <filter token="version.buildnumber" value="${version.buildnumber}" />
            <filter token="version.extra" value="${version.extra}" />
            <filter token="version.extra1" value="${version.extra1}" />
            <filter token="min.logger.def.version" value="${min.logger.def.version}" />
            <filter token="build.arch" value="${build.arch}" />
        </filterset>
    </target>

    <!-- =================================================================== -->
    <!-- cleans all generated files                                          -->
    <!-- =================================================================== -->
    <target name="clean" depends="-init" description="Clean all generated files">
        <delete dir="${build.dir}" failonerror="false" />
    </target>

    <!-- =================================================================== -->
    <!-- pre-build preparation                                               -->
    <!-- =================================================================== -->
    <target name="prepare" depends="-init" description="Pre-build preparation">
        <!-- generate the Version class -->
        <copy overwrite="true" tofile="${src.java.dir}/com/romraider/Version.java"
              file="src/main/java/com/romraider/Version.java.template">
            <filterset refid="version.filterset" />
        </copy>
    </target>

    <!-- =================================================================== -->
    <!-- complete rebuild                                                    -->
    <!-- =================================================================== -->
    <target name="rebuild" depends="clean, build" description="Rebuild"/>

    <!-- =================================================================== -->
    <!-- Compiles the source directory                                       -->
    <!-- =================================================================== -->
    <target name="compile-windows" depends="prepare" description="Compile the source directory for Windows">
        <macro_compile os="${os.windows}" srcdir="${src.java.dir}" destdir="${classes.dir}" classpathref="windows.classpath"/>
    </target>
    <target name="compile-linux" depends="prepare" description="Compile the source directory for Linux">
        <macro_compile os="${os.linux}" srcdir="${src.java.dir}" destdir="${classes.dir}"  classpathref="linux.classpath"/>
    </target>

    <!-- =================================================================== -->
    <!-- Build jar files                                                     -->
    <!-- =================================================================== -->
    <target name="build-linux" depends="compile-linux, -java3d-graph3d" description="Build the Jar file for Linux">
        <macro_jar os="${os.linux}" basedir="${classes.dir}"/>
    </target>
    <target name="build-windows" depends="compile-windows, -java3d-graph3d" description="Build the Jar file for Windows">
        <macro_jar os="${os.windows}" basedir="${classes.dir}"/>
    </target>
    <target name="build" depends="build-windows, build-linux" description="Build the Jar files for Linux and Windows"/>

    <!-- =================================================================== -->
    <!-- Compile and run all unit tests                                      -->
    <!-- =================================================================== -->
    <target name="compile-for-unittests" depends="build-linux" description="Compile unit tests">
        <mkdir dir="${testclasses.dir}" />
        <macro_compile os="${os.linux}" srcdir="${src.test.java.dir}" destdir="${testclasses.dir}" classpathref="junit_compile.classpath" />
    </target>
    <target name="unittest" depends="compile-for-unittests" description="Perform unit tests">
        <!-- We execute same coverage on both Windows and Linux-->
        <mkdir dir="${test.home.dir}/.RomRaider" />
        <junit printsummary="withOutAndErr" showoutput="true"
               haltonfailure="true" fork="true" forkmode="once">
            <classpath refid="junit_runtime.classpath" />
            <sysproperty key="user.home" value="${test.home.dir}" />
            <sysproperty key="java.awt.headless" value="${test.headless}" />
            <sysproperty key="romraider.test.xdfDir"
                         value="${romraider.test.xdfDir}" />
            <batchtest skipNonTests="true">
                <fileset dir="${testclasses.dir}">
                    <include name="**/*Test*" />
                </fileset>
            </batchtest>
            <formatter type="brief" usefile="false"/>
        </junit>
        <fail message="test failed" if="junit.failure" />
    </target>

    <!-- ================================================================== -->
    <!-- generate javadoc                                                   -->
    <!-- ================================================================== -->
    <target name="javadoc" depends="-init" description="Generate javadocs">
        <delete quiet="true" dir="${javadoc.dir}" />
        <mkdir dir="${javadoc.dir}" />
        <javadoc windowtitle="${name.package}" header="${javadoc.header}" sourcepath="${src.java.dir}" author="yes"
                 version="yes" destdir="${javadoc.dir}"
                 breakiterator="yes" maxmemory="96m">
            <packageset dir="src">
                <include name="**" />
            </packageset>
            <bottom>${javadoc.footer}</bottom>
            <classpath refid="${os.windows}.classpath" />
        </javadoc>
    </target>

    <!-- =================================================================== -->
    <!-- JogAmp Java3D                                                       -->
    <!--   The Graph3d library is built against the discontinued Java3D 1.5  -->
    <!--   packages, whose Windows and X11 classes reach into sun.awt and    -->
    <!--   are rejected on Java 17. Its bytecode is relocated onto JogAmp    -->
    <!--   Java3D, which every package then carries together with the JOGL   -->
    <!--   natives of its operating system.                                  -->
    <!-- =================================================================== -->
    <target name="-java3d" depends="-init">
        <mkdir dir="${jogamp.dir}" />
        <macro_fetch_artifact
            path="org/jogamp/java3d/java3d-core/${java3d.version}"
            file="java3d-core-${java3d.version}.jar"
            sha256="894b00e177da90590deec06274ec7410db0c7fe8cfdb75af4013fd4a83c4b95b" />
        <macro_fetch_artifact
            path="org/jogamp/java3d/java3d-utils/${java3d.version}"
            file="java3d-utils-${java3d.version}.jar"
            sha256="194f3ec7a857c883fe4704a56c510fb769cfaec9a2eb48f5942a247eb5d82f03" />
        <macro_fetch_artifact
            path="org/jogamp/java3d/vecmath/${java3d.version}"
            file="vecmath-${java3d.version}.jar"
            sha256="4bb77e7ec930c6e59be3533ced4597a4c43b5eee2262f9f9bc147cadb2ff7f5b" />
        <macro_fetch_artifact
            path="org/jogamp/gluegen/gluegen-rt/${jogamp.version}"
            file="gluegen-rt-${jogamp.version}.jar"
            sha256="465bbc8d410b872a76b5b901cdb9c2c07905edd5e61a7120dc6a4d007880ec2f" />
        <macro_fetch_artifact
            path="org/jogamp/jogl/jogl-all/${jogamp.version}"
            file="jogl-all-${jogamp.version}.jar"
            sha256="34c919bc6073c2d9e73cbe7558c4e9de6b5c58146f3658e2bcc5f23ec3fccc9f" />
        <macro_fetch_artifact
            path="org/jogamp/joal/joal/${jogamp.version}"
            file="joal-${jogamp.version}.jar"
            sha256="ac50705ca328ddb7664882fce582306b88722f936b81642f8c384fd707de57ce" />
        <macro_fetch_artifact
            path="org/jogamp/gluegen/gluegen-rt/${jogamp.version}"
            file="gluegen-rt-${jogamp.version}-natives-${jogamp.natives.windows}.jar"
            sha256="c7c9138606858fed0b1650a2444cc1bc96599cc635a8d879979a37646e8594b1" />
        <macro_fetch_artifact
            path="org/jogamp/jogl/jogl-all/${jogamp.version}"
            file="jogl-all-${jogamp.version}-natives-${jogamp.natives.windows}.jar"
            sha256="33081ebfac520d7d283830a614f458f728104bef4eff56b52f604ee8c5af90c8" />
        <macro_fetch_artifact
            path="org/jogamp/joal/joal/${jogamp.version}"
            file="joal-${jogamp.version}-natives-${jogamp.natives.windows}.jar"
            sha256="5367cb899601ddbf5ff45aa23060edf5ec8267e356bc9126fb97d0642fe0e8a1" />
        <macro_fetch_artifact
            path="org/jogamp/gluegen/gluegen-rt/${jogamp.version}"
            file="gluegen-rt-${jogamp.version}-natives-${jogamp.natives.linux}.jar"
            sha256="d500a38dedcbd6dfa89c5ae943a22d1051b1dbf1502f8544337bbe57d118f2c5" />
        <macro_fetch_artifact
            path="org/jogamp/jogl/jogl-all/${jogamp.version}"
            file="jogl-all-${jogamp.version}-natives-${jogamp.natives.linux}.jar"
            sha256="3d0ed2674059fc207166ce1351de8d30e0b6102af12ca8b84fbf1bc3f246038a" />
        <macro_fetch_artifact
            path="org/jogamp/joal/joal/${jogamp.version}"
            file="joal-${jogamp.version}-natives-${jogamp.natives.linux}.jar"
            sha256="146d01038cdf7c556c06edfaa2f4dec110c9872d52b36c01abb340d61bc7523c" />
    </target>

    <target name="-java3d-graph3d" depends="-java3d">
        <mkdir dir="${java3d.dir}/adapter" />
        <javac
            failonerror="true"
            srcdir="${basedir}/tools/build"
            destdir="${java3d.dir}/adapter"
            release="${javac.release}"
            includeantruntime="false"
            debug="${debug}"
            deprecation="${deprecation}"
            encoding="UTF-8" />
        <java
            classname="com.romraider.build.Java3dBytecodeAdapter"
            classpath="${java3d.dir}/adapter"
            fork="true"
            failonerror="true">
            <arg file="lib/common/Graph3d.jar" />
            <arg file="${graph3d.adapted}" />
        </java>

        <delete dir="${java3d.dir}/verify" />
        <unzip src="${graph3d.adapted}" dest="${java3d.dir}/verify" />
        <fileset id="graph3d.legacy" dir="${java3d.dir}/verify" includes="**/*.class">
            <contains text="javax/media/j3d" />
        </fileset>
        <fileset id="graph3d.jogamp" dir="${java3d.dir}/verify" includes="**/*.class">
            <contains text="org/jogamp/java3d" />
        </fileset>
        <fail message="Graph3d.jar still refers to the discontinued Java3D packages">
            <condition>
                <resourcecount refid="graph3d.legacy" when="greater" count="0" />
            </condition>
        </fail>
        <fail message="Graph3d.jar was not relocated onto JogAmp Java3D">
            <condition>
                <resourcecount refid="graph3d.jogamp" when="equal" count="0" />
            </condition>
        </fail>
    </target>

    <!-- =================================================================== -->
    <!-- create standalone ZIP                                               -->
    <!-- =================================================================== -->
    <target name="standalone" depends="rebuild, unittest"
        description="Create standalone ZIP packages">
        <macro_standalone os="${os.windows}" />
        <macro_standalone os="${os.linux}" />
    </target>

    <!-- =================================================================== -->
    <!-- all                                                                 -->
    <!-- =================================================================== -->
    <target name="all" depends="rebuild, unittest, standalone"
        description="Compile and create distribution packages" />

    <!-- =================================================================== -->
    <!-- Macros                                                              -->
    <!-- =================================================================== -->
    <macrodef name="macro_fetch_artifact">
        <attribute name="path" />
        <attribute name="file" />
        <attribute name="sha256" />
        <sequential>
            <local name="artifact.verified" />
            <get src="${maven.central}/@{path}/@{file}"
                 dest="${jogamp.dir}/@{file}"
                 skipexisting="true" />
            <checksum file="${jogamp.dir}/@{file}"
                      algorithm="SHA-256"
                      property="@{sha256}"
                      verifyproperty="artifact.verified" />
            <fail message="SHA-256 mismatch for @{file}">
                <condition>
                    <isfalse value="${artifact.verified}" />
                </condition>
            </fail>
        </sequential>
    </macrodef>

    <macrodef name="macro_common_libs">
        <attribute name="os" />
        <sequential>
            <delete dir="${build.dir}/@{os}/package/lib/common" />
            <mkdir dir="${build.dir}/@{os}/package/lib/common" />
            <copy todir="${build.dir}/@{os}/package/lib/common">
                <fileset dir="lib/common"
                         excludes="Graph3d.jar j3dcore.jar j3dutils.jar vecmath.jar" />
                <fileset file="${graph3d.adapted}" />
                <fileset dir="${jogamp.dir}">
                    <include name="java3d-core-${java3d.version}.jar" />
                    <include name="java3d-utils-${java3d.version}.jar" />
                    <include name="vecmath-${java3d.version}.jar" />
                    <include name="gluegen-rt-${jogamp.version}.jar" />
                    <include name="jogl-all-${jogamp.version}.jar" />
                    <include name="joal-${jogamp.version}.jar" />
                    <include name="gluegen-rt-${jogamp.version}-natives-${jogamp.natives.@{os}}.jar" />
                    <include name="jogl-all-${jogamp.version}-natives-${jogamp.natives.@{os}}.jar" />
                    <include name="joal-${jogamp.version}-natives-${jogamp.natives.@{os}}.jar" />
                </fileset>
            </copy>
        </sequential>
    </macrodef>

    <macrodef name="macro_jar">
        <attribute name="os" />
        <attribute name="basedir" />
        <sequential>
            <macro_common_libs os="@{os}" />
            <manifestclasspath property="@{os}.jar.classpath"
                               jarfile="${build.dir}/@{os}/package/${jar.package}">
                <classpath>
                    <fileset dir="${build.dir}/@{os}/package/lib/common" includes="*.jar" />
                </classpath>
            </manifestclasspath>
            <manifest file="${build.dir}/@{os}/MANIFEST.MF">
                <attribute name="Built-By" value="${name.maintainer}" />
                <attribute name="Main-Class" value="${class.start}" />
                <attribute name="Class-Path" value="${@{os}.jar.classpath}" />
            </manifest>
            <jar basedir="@{basedir}" destfile="${build.dir}/@{os}/package/${jar.package}"
                 manifest="${build.dir}/@{os}/MANIFEST.MF">
                 <fileset dir="${src.res.dir}">
                    <include name="**/*.*" />
                </fileset>
            </jar>
        </sequential>
    </macrodef>

    <macrodef name="macro_compile">
        <attribute name="os" />
        <attribute name="srcdir" />
        <attribute name="destdir" />
        <attribute name="classpathref" />
        <sequential>
            <mkdir dir="@{destdir}" />
            <javac
                failonerror="true"
                srcdir="@{srcdir}"
                destdir="@{destdir}"
                release="${javac.release}"
                includeantruntime="false"
                debug="${debug}"
                verbose="${javac.verbose}"
                deprecation="${deprecation}"
                compiler="modern"
                encoding="UTF-8" >
                <!--
                <compilerarg value="-Xlint" />
                -->
                <classpath refid="@{classpathref}" />
            </javac>
        </sequential>
    </macrodef>

    <macrodef name="macro_standalone">
        <attribute name="os" />
        <sequential>
            <zip destfile="${dist.dir}/@{os}/${name.package}${version.major}.${version.minor}.${version.patch}${version.extra}${version.extra1}-@{os}.zip">
                <zipfileset file="${build.dir}/@{os}/package/${jar.package}" prefix="${name.package}" />
                <zipfileset file="scripts/run.${ext.@{os}}" prefix="${name.package}" filemode="755" />
                <zipfileset file="license.txt" prefix="${name.package}" />
                <zipfileset file="release_notes.txt" prefix="${name.package}" />
                <zipfileset file="lib/log4j.properties" prefix="${name.package}/lib"/>
                <zipfileset dir="plugins" prefix="${name.package}/plugins" />
                <zipfileset dir="${build.dir}/@{os}/package/lib/common" prefix="${name.package}/lib/common" />
                <zipfileset dir="lib/@{os}" prefix="${name.package}/lib/@{os}"
                            excludes="**/j3dcore*.dll **/libj3dcore*.so" />
                <zipfileset dir="src" prefix="${name.package}/src" excludes="**/*.template" />
                <zipfileset dir="customize" prefix="${name.package}/customize"/>
                <zipfileset dir="i18n" prefix="${name.package}/i18n"/>
            </zip>
        </sequential>
    </macrodef>
</project>
